# FIRETRACE backend configuration.
#
# Copy this file to backend/.env and edit only what you need. Every value below
# is a documented default or a placeholder; none of them is a credential.
# The evidence API (`uvicorn api:app`) needs none of this to boot.

# --- HTTP binding ----------------------------------------------------------
FIRETRACE_HOST=127.0.0.1
FIRETRACE_PORT=8000

# Comma-separated browser origins allowed to call the API.
# The default regex already permits localhost, 127.0.0.1, [::1] and RFC1918 LAN.
# FIRETRACE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# FIRETRACE_ALLOWED_ORIGIN_REGEX=

# --- Evidence API limits ---------------------------------------------------
# Any POST body above 1 MiB is rejected with 413.
FIRETRACE_MAX_REQUEST_BYTES=1048576
FIRETRACE_RATE_LIMIT_PER_MINUTE=90
FIRETRACE_RATE_LIMIT_BURST=30
FIRETRACE_MAX_QUESTION_CHARS=500

# --- Paths -----------------------------------------------------------------
# FIRETRACE_CORPUS=../src/data/corpus.json
# FIRETRACE_MANIFEST=../src/data/source_manifest.json
# FIRETRACE_VALIDATION=../src/data/validation_report.json
# FIRETRACE_DB_PATH=./data/firetrace.db
FIRETRACE_MODELS_DIR=./models

# --- Optional local LLM (Ollama) ------------------------------------------
# Leave disabled to stay fully deterministic. The API never requires it.
FIRETRACE_LLM_ENABLED=0
FIRETRACE_LLM_WARMUP=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=<ollama-model-name>

# --- Optional ASR (whisper.cpp) -------------------------------------------
WHISPER_MODE=server
WHISPER_MODEL=<absolute-path-to-ggml-model.bin>
WHISPER_THREADS=4
WHISPER_AUTO_START=0
WHISPER_SERVER_HOST=127.0.0.1
WHISPER_SERVER_PORT=8178

# --- Optional TTS (sherpa-onnx VITS) --------------------------------------
TTS_ENGINE=sherpa
TTS_THREADS=4
TTS_SPEED=1.0
SHERPA_TTS_DIR=./models/tts/sherpa-ljs

# --- Optional VAD (Silero) -------------------------------------------------
VAD_MODEL=./models/vad/silero_vad.onnx
VAD_THRESHOLD=0.55
VAD_SILENCE_MS=850

# --- Storage ---------------------------------------------------------------
FIRETRACE_STORE_TRANSCRIPTS=1
FIRETRACE_LOG_TRANSCRIPTS=0