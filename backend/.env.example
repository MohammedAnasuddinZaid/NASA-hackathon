# FIRETRACE backend (local-only). Copy to backend/.env and adjust.
FIRETRACE_HOST=127.0.0.1
FIRETRACE_PORT=8000
FIRETRACE_MODELS_DIR=./models

# Local LLM (Ollama). Leave FIRETRACE_LLM_ENABLED=0 to stay fully deterministic.
FIRETRACE_LLM_ENABLED=1
FIRETRACE_LLM_WARMUP=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# whisper.cpp
WHISPER_MODE=server
WHISPER_AUTO_START=1
WHISPER_THREADS=4

# sherpa-onnx TTS
TTS_ENGINE=sherpa
TTS_THREADS=4
TTS_SPEED=1.0

# Silero VAD
VAD_THRESHOLD=0.55
VAD_SILENCE_MS=850

# Storage
FIRETRACE_STORE_TRANSCRIPTS=1
FIRETRACE_LOG_TRANSCRIPTS=0
