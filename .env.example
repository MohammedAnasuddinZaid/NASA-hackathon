# Server-only: never prefix credentials with VITE_.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_SECONDS=30

# Public browser configuration. Blank API base uses same-origin /api/v1 (Vite proxy locally).
VITE_EVIDENCE_API_BASE=
VITE_EVIDENCE_API=auto
# Legacy VITE_FIRETRACE_API_BASE is supported when VITE_EVIDENCE_API_BASE is unset.
