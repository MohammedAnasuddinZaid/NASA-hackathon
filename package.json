{
  "name": "firertrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FIRETRACE \u00e2\u20ac\u201d evidence intelligence for spacecraft fire safety research",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "tsx scripts/run-benchmark.ts",
    "ingest": "python pipeline/ingest.py",
    "e2e": "playwright test",
    "shots": "tsx scripts/capture.ts",
    "validate:data": "python -m unittest discover -s pipeline -p test_*.py -v"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  }
}
